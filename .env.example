# Copia este archivo a .env y reemplaza los valores. NUNCA subas .env al repositorio.

# --- Docker Compose (MongoDB replica set rs0) ---
MONGO_ROOT_USER=antfish_admin
MONGO_ROOT_PASSWORD=cambia-esta-clave-larga-y-aleatoria
# Contraseña de Redis (requirepass). Debe coincidir con la de REDIS_URL.
REDIS_PASSWORD=cambia-esta-clave-larga-y-aleatoria

# Usuarios de mínimo privilegio (los crea el servicio mongo-users). Contraseñas largas y aleatorias.
MONGO_APP_USER=antfish_app
MONGO_APP_PASSWORD=
MONGO_MIGRATOR_USER=antfish_migrator
MONGO_MIGRATOR_PASSWORD=

# --- Aplicación ---
# El replica set es obligatorio (transacciones ACID). Si la clave tiene
# caracteres especiales, codifícala en URL (p. ej. @ -> %40).
MONGODB_URL=mongodb://antfish_app:<MONGO_APP_PASSWORD>@localhost:27017/antfish_db?replicaSet=rs0&authSource=admin
# Solo para ejecutar init_db (python -m app.repositories.mongo.init_db); nunca la API.
MONGODB_MIGRATION_URL=mongodb://antfish_migrator:<MONGO_MIGRATOR_PASSWORD>@localhost:27017/antfish_db?replicaSet=rs0&authSource=admin
DATABASE_NAME=antfish_db
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0

# development | production (en production se desactivan /docs, /redoc y /openapi.json)
ENVIRONMENT=development

# OBLIGATORIOS: mínimo 32 caracteres, aleatorios y distintos entre sí. La app no arranca sin ellos.
# Generar:  python -c "import secrets; print(secrets.token_urlsafe(64))"
HMAC_PEPPER=
JWT_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
# Client ID OAuth (aud del ID token de Google Sign-In). Sin él, POST /auth/google responde 503.
GOOGLE_CLIENT_ID=
GOOGLE_WEB_RISK_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=
# PhishTank está deshabilitado por defecto (API bloqueada, sin claves nuevas). true = consultarlo.
PHISHTANK_ENABLED=false
