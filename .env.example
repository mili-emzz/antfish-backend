# Copia este archivo a .env y reemplaza los valores. NUNCA subas .env al repositorio.

# --- Docker Compose (MongoDB replica set rs0) ---
MONGO_ROOT_USER=antfish_admin
MONGO_ROOT_PASSWORD=cambia-esta-clave-larga-y-aleatoria

# --- Aplicación ---
# El replica set es obligatorio (transacciones ACID). Si la clave tiene
# caracteres especiales, codifícala en URL (p. ej. @ -> %40).
MONGODB_URL=mongodb://antfish_admin:cambia-esta-clave-larga-y-aleatoria@localhost:27017/?replicaSet=rs0&authSource=admin
DATABASE_NAME=antfish_db
REDIS_URL=redis://localhost:6379

HMAC_PEPPER=
JWT_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
GOOGLE_WEB_RISK_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=
