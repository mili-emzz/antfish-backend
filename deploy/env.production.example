# Plantilla de variables de producción (SOLO nombres y ejemplos; sin secretos reales).
# Copiar a deploy/.env.production (ignorado por git) y rellenar en el servidor.
# Generar secretos:  openssl rand -hex 32     (usar hex: sin caracteres especiales en URLs)

# --- Dominio y HTTPS (Caddy) ---
DOMAIN=api.tu-dominio.com
ACME_EMAIL=tu-correo@tu-dominio.com

# --- Aplicación ---
ENVIRONMENT=production
DATABASE_NAME=antfish_db

# --- MongoDB Atlas (replica set + TLS incluidos) ---
# Usuario 'antfish_app' con rol readWrite sobre antfish_db.
MONGODB_URL=mongodb+srv://antfish_app:<MONGO_APP_PASSWORD>@<cluster>.mongodb.net/antfish_db?retryWrites=true&w=majority
# Usuario 'antfish_migrator' (readWrite + dbAdmin): solo para init_db, ver README.
MONGODB_MIGRATION_URL=mongodb+srv://antfish_migrator:<MONGO_MIGRATOR_PASSWORD>@<cluster>.mongodb.net/antfish_db?retryWrites=true&w=majority

# --- Redis (contenedor interno; REDIS_URL se compone en el compose) ---
REDIS_PASSWORD=<openssl rand -hex 24>

# --- Secretos de la API (≥32 caracteres, distintos entre sí) ---
HMAC_PEPPER=<openssl rand -hex 32>
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>

# --- Servicios externos ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@tu-dominio.com
GOOGLE_WEB_RISK_API_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_CLIENT_ID=
